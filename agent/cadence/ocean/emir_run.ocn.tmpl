;; ============================================================
;; EMIR from OCEAN (ADE's scripting layer) -- a SKETCH, UNVERIFIED until checked
;; on site (no check exists for it: check it by hand).
;;
;; Not run on any Virtuoso. EMIR's Cadence route with an on-site check is a
;; plain Spectre testbench (agent/cadence/spectre/) plus `emir run`, verified
;; with `emir verify-sim --sim spectre --run`. This is the same three steps in
;; OCEAN, written from general OCEAN usage. Check every function and
;; option against your release's OCEAN reference before relying on it; the
;; ones marked UNVERIFIED below are the likeliest to differ.
;;
;;   ocean -nograph -restore emir_run.ocn
;;
;; Inputs: an ADE netlist directory whose top instantiates the block's RC
;; extraction, and that RC DSPF, which EMIR screens with every branch current
;; the simulation saves (rcc). Fill the ${...} fields first.
;; ============================================================

emirBin    = "${EMIR_BIN}"          ; the emir command, e.g. <clone>/bin/emir
emirDspf   = "${DSPF}"              ; the RC DSPF, simulated and screened (rcc)
emirProc   = "${PROCESS_YAML}"      ; your PDK's EMIR process file
emirOut    = "${OUT_DIR}"
emirPrefix = "${INST_PREFIX}"       ; what the testbench calls the block, e.g. "XDUT."
emirSaves  = strcat(emirOut "/emir_save.scs")

;; one word for /bin/sh (system() runs its string through a shell)
procedure( emirOcnQ(s)
  let( (out c)
    out = "'"
    for( i 1 strlen(s)
      c = substring(s i 1)
      out = strcat(out if( c == "'" "'\\''" c )) )
    strcat(out "'") ))

;; 1. what to save: every branch current of the RC netlist
system(sprintf(nil "mkdir -p %s && %s save-lines %s --prefix %s --out %s"
               emirOcnQ(emirOut) emirOcnQ(emirBin) emirOcnQ(emirDspf)
               emirOcnQ(emirPrefix) emirOcnQ(emirSaves)))

;; 2. simulate with those saves, in a text result format
simulator('spectre)
design("${NETLIST_DIR}/netlist")
resultsDir(strcat(emirOut "/sim"))
modelFile('("${MODELS}" "${SECTION}"))
definitionFile(emirSaves)                 ; UNVERIFIED: the ADE "Definition Files" hook
option('rawfmt "psfascii")                ; UNVERIFIED: else convert the PSF to text afterwards
analysis('tran ?stop "${TSTOP}" ?errpreset "conservative")
temp(${TEMP})
run()

;; 3. screen the result (summary, HTML report, viewer data)
system(sprintf(nil "%s run %s --process %s --net all --cc-sim %s --summary-out %s --html %s --viewer %s --lib %s --cell %s"
               emirOcnQ(emirBin) emirOcnQ(emirDspf) emirOcnQ(emirProc)
               emirOcnQ(strcat(emirOut "/sim/psf"))
               emirOcnQ(strcat(emirOut "/summary.json"))
               emirOcnQ(strcat(emirOut "/html")) emirOcnQ(strcat(emirOut "/viewer"))
               emirOcnQ("${LIB}") emirOcnQ("${CELL}")))
exit()
