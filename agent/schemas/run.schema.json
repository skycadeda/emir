                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "name",
                "avg_ratio",
                "abs_avg_ratio"
              ]
            }
          },
          "description": "Per net, branches whose current reverses: the signed average the avg check uses cancels, while the time average of |I| reaches the warn fraction of the avg limit. EMIR applies no bidirectional (recovery) rule: check them against the PDK's AC rule."
        },
        "diagonal_wires": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "description": "Per net, the wires on diagonal (non-Manhattan) shapes (`$dir=diag`, the magic route): checked at the width magic gives, its tiles' extent and not the width across the current, so their current density can read low (EMIR-W647)."
        },
        "via_crowding": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "layer": {
                  "type": "string"
                },
