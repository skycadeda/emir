                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "name",
                "ratio"
              ]
            }
          },
          "description": "Per net, via arrays within 10 % of the limit: the per-cut check uses the array's mean current, and the cuts facing the current carry more; confirm them cut by cut (the extractor's per-cut vias)."
        }
