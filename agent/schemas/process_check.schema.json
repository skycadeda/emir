{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:emir:schema:process_check:1",
  "title": "emir process check",
  "description": "What a process file still lacks before a run. Exit 0 when `passed`, else 2 (a required value empty, EMIR-E320, or another FAIL). `empty` lists the values still null; `unsourced` the values of a hand-entered file that name no source; `inferred` the stacking `emir process new` inferred and nobody confirmed; `suspects` the values outside their quantity's plausible range (a likely unit slip: `likely`); `coverage` (with --dspf) the DSPF layer tokens the file does not cover. The findings are `emir check`'s, which runs the same checks.",
  "type": "object",
  "properties": {
    "schema": {
      "const": "emir.process_check/1"
    },
    "emir_version": {
      "type": "string"
    },
    "process": {
      "type": "string"
    },
    "dspf": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "pdk": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "provenance": {
      "anyOf": [
        {
          "enum": [
            "hand-entered",
            "imported-ict",
            "public-pdk-data",
            "mixed"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "passed": {
      "type": "boolean"
    },
    "n_fail": {
      "type": "integer"
    },
    "n_warn": {
      "type": "integer"
    },
    "empty": {
      "type": "object",
      "properties": {
        "required": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "unit": {
                "type": "string"
              },
              "what": {
                "type": "string"
              }
            },
            "required": [
              "path",
              "unit",
              "what"
            ]
          }
        },
        "optional": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "unit": {
                "type": "string"
              },
              "what": {
                "type": "string"
              }
            },
            "required": [
              "path",
              "unit",
              "what"
            ]
          }
        }
      },
      "required": [
        "required",
        "optional"
      ],
      "description": "The values present but empty (null): required (emir refuses to run) and optional (what they would check or scale is not used)."
    },
    "unsourced": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "inferred": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "suspects": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "value": {
            "type": "number"
          },
          "unit": {
            "type": "string"
          },
          "range": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "likely": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "path",
          "value",
          "unit",
          "range"
        ]
      }
    },
    "coverage": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "tokens": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "missing": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "segments_not_covered": {
              "type": "integer"
            }
          },
          "required": [
            "tokens",
            "missing"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "level": {
            "enum": [
              "FAIL",
              "WARN",
              "INFO",
              "OK"
            ]
          },
          "code": {
            "type": "string",
            "pattern": "^EMIR-[EWI][1-9][0-9]{2}$"
          },
          "area": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "fix": {
            "type": "string"
          },
          "command": {
            "type": "string"
          }
        },
        "required": [
          "level",
          "code",
          "area",
          "message",
          "fix",
          "command"
        ]
      }
    },
    "next_steps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "why": {
            "type": "string"
          },
          "command": {
            "type": "string"
          },
          "shell": {
            "const": true,
            "description": "present (true) when the command is not an emir command (ls, tail, klayout ...): it needs a shell, which the MCP server does not have (emir_cli refuses it with EMIR-E591)"
          },
          "needs_human": {
            "const": true,
            "description": "present (true) when the step leads to a run the person decides on (it re-simulates, or runs a licensed tool): ask them first"
          }
        },
        "required": [
          "why",
          "command"
        ],
        "description": "Exact commands to run next, in order; each runs as printed. An emir command keeps the caller's --format, except a run's `emir report` step (its Markdown is what to relay)."
      }
    }
  },
  "required": [
    "schema",
    "emir_version",
    "process",
    "passed",
    "n_fail",
    "n_warn",
    "empty",
    "unsourced",
    "inferred",
    "suspects",
    "findings",
    "next_steps"
  ]
}
