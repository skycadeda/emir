{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:emir:schema:validate:1",
  "title": "emir validate",
  "description": "The analytic validation suite. Exit 0 when `passed`, else 70 with `code` EMIR-E903.",
  "type": "object",
  "properties": {
    "schema": {
      "const": "emir.validate/1"
    },
    "emir_version": {
      "type": "string"
    },
    "passed": {
      "type": "boolean"
    },
    "code": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^EMIR-[EWI][1-9][0-9]{2}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "SKIP"
            ]
          },
          "seconds": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "name",
          "kind",
          "status"
        ]
      }
    },
    "n_run": {
      "type": "integer"
    },
    "n_failed": {
      "type": "integer"
    },
    "n_skipped": {
      "type": "integer"
    },
    "seconds": {
      "type": "number"
    },
    "out_dir": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema",
    "emir_version",
    "passed",
    "code",
    "cases",
    "n_run",
    "n_failed",
    "n_skipped"
  ]
}
