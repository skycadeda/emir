                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "found": {
              "type": "boolean"
            },
            "source": {
              "type": "string"
            },
            "looked_for": {
              "type": "string"
            }
          },
          "required": [
            "path",
            "found",
            "source"
          ]
        }
      },
      "required": [
        "pvs",
        "qrc"
      ]
    },
    "settings": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
