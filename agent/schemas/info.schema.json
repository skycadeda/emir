{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:emir:schema:info:1",
  "title": "emir info",
  "description": "Where the tools, packages and settings were found.",
  "type": "object",
  "properties": {
    "schema": {
      "const": "emir.info/1"
    },
    "emir_version": {
      "type": "string"
    },
    "python": {
      "type": "string"
    },
    "package_dir": {
      "type": "string"
    },
    "sample_dir": {
      "type": "string"
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "found": {
            "type": "boolean"
          },
          "source": {
            "type": "string"
          },
          "licensed": {
            "type": "boolean"
          },
          "version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "verified": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "version": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "format": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "date": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "name",
          "path",
          "found",
          "source",
          "licensed"
        ]
      }
    },
    "records_file": {
      "type": "string"
    },
    "settings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "value": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "source": {
            "type": "string"
          }
        },
        "required": [
          "key",
          "value",
          "source"
        ]
      }
    },
    "site_file": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "packages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "required": {
            "type": "boolean"
          },
          "purpose": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "version",
          "required"
        ]
      }
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "exit_codes": {
      "type": "object"
    },
    "notices": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^EMIR-[EWI][1-9][0-9]{2}$"
          },
          "level": {
            "enum": [
              "warning",
              "info"
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "level",
          "message"
        ]
      }
    }
  },
  "required": [
    "schema",
    "emir_version",
    "python",
    "tools",
    "packages",
    "commands",
    "exit_codes"
  ]
}
