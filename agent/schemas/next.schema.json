{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:emir:schema:next:1",
  "title": "emir next",
  "description": "The recommended command sequence for what the agent has. Run the steps in order and stop at the first that exits non-zero. Steps with `needs_human` true need the person's go-ahead (a licensed tool, or a long run) before the agent runs them. A step with `status` waiting does not run as printed: its `placeholders` (`<result.raw>` ...) stand for files the steps in `after` produce, to be replaced first.",
  "type": "object",
  "properties": {
    "schema": {
      "const": "emir.next/1"
    },
    "emir_version": {
      "type": "string"
    },
    "inputs": {
      "type": "object"
    },
    "facts": {
      "type": "object",
      "description": "what the plan learnt from the inputs (`size`, `dspf`, `result`); on the magic route (--gds, no DSPF) also `magic_route` (the magic the extraction runs, as `emir info` gives it) and `pdk_root`"
    },
    "tools": {
      "type": "object"
    },
    "mode": {
      "type": "object",
      "properties": {
        "chosen": {
          "anyOf": [
            {
              "enum": [
                "rcc",
                "dc"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "why": {
          "type": "string"
        }
      },
      "required": [
        "chosen",
        "why"
      ],
      "description": "Where the planned run's currents come from: rcc (a simulation of the RC netlist, every branch current read), dc (--currents), or null (not known yet)"
    },
    "missing": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "what": {
            "type": "string"
          },
          "why": {
            "type": "string"
          },
          "how": {
            "type": "string"
          }
        },
        "required": [
          "what",
          "why",
          "how"
        ]
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "n": {
            "type": "integer"
          },
          "id": {
            "type": "string"
          },
          "command": {
            "type": "string"
          },
          "why": {
            "type": "string"
          },
          "needs_human": {
            "type": "boolean"
          },
          "licensed_tool": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "long_run": {
            "type": "boolean"
          },
          "ask": {
            "type": "string",
            "description": "present when the step needs something only the person can give or agree to (values typed from a document): ask them first"
          },
          "status": {
            "enum": [
              "todo",
              "waiting"
            ]
          },
          "after": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "placeholders": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tool": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "arguments": {
                    "type": "object"
                  }
                },
                "required": [
                  "name"
                ],
                "description": "over MCP (`emir mcp`): the typed tool call that runs the step's command (null: not an emir command)"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "n",
          "id",
          "command",
          "why",
          "needs_human",
          "licensed_tool",
          "long_run",
          "status",
          "after",
          "placeholders"
        ],
        "description": "One step of the plan."
      }
    },
    "advice": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "thresholds": {
      "type": "object"
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schema",
    "emir_version",
    "inputs",
    "facts",
    "tools",
    "mode",
    "missing",
    "steps",
    "advice",
    "rules"
  ]
}
