{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:emir:schema:probe:1",
  "title": "emir probe",
  "description": "A netlist rewritten with a 0 V source in series with each device terminal on the nets (`probes`; `count` of them), and the files written (`files`: the output and copies of included files that got probes). `names_out` is the names sidecar (with its `probes` list) for `emir save-lines --probes` and `emir simulate --probes`. `uncovered`: DSPF instance pins with no probe; `unmatched`: probes on pins the DSPF does not list; `guessed`: subcircuits whose pins were named by position.",
  "type": "object",
  "properties": {
    "schema": {
      "const": "emir.probe/1"
    },
    "emir_version": {
      "type": "string"
    },
    "netlist": {
      "type": "string"
    },
    "out": {
      "type": "string"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          }
        },
        "required": [
          "from",
          "to"
        ]
      }
    },
    "nets": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "scope": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "path": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "why": {
      "type": "string"
    },
    "count": {
      "type": "integer"
    },
    "probes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string"
          },
          "pin": {
            "type": "string"
          },
          "net": {
            "type": "string"
          },
          "element": {
            "type": "string"
          },
          "terminal": {
            "type": "string"
          },
          "matched": {
            "type": "boolean"
          },
          "file": {
            "type": "string"
          },
          "line": {
            "type": "integer"
          }
        },
        "required": [
          "source",
          "pin",
          "net",
          "element",
          "terminal",
          "matched"
        ]
      }
    },
    "unmatched": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "uncovered": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "guessed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "names_out": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "has_tran": {
      "type": "boolean"
    },
    "notices": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^EMIR-[EWI][1-9][0-9]{2}$"
          },
          "level": {
            "enum": [
              "warning",
              "info"
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "level",
          "message"
        ]
      }
    },
    "next_steps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "why": {
            "type": "string"
          },
          "command": {
            "type": "string"
          },
          "shell": {
            "const": true,
            "description": "present (true) when the command is not an emir command (ls, tail, klayout ...): it needs a shell, which the MCP server does not have (emir_cli refuses it with EMIR-E591)"
          },
          "needs_human": {
            "const": true,
            "description": "present (true) when the step leads to a run the person decides on (it re-simulates, or runs a licensed tool): ask them first"
          }
        },
        "required": [
          "why",
          "command"
        ],
        "description": "Exact commands to run next, in order; each runs as printed. An emir command keeps the caller's --format, except a run's `emir report` step (its Markdown is what to relay)."
      }
    }
  },
  "required": [
    "schema",
    "emir_version",
    "netlist",
    "out",
    "files",
    "nets",
    "count",
    "probes",
    "unmatched",
    "uncovered",
    "names_out",
    "next_steps"
  ]
}
