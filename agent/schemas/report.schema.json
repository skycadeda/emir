{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:emir:schema:report:1",
  "title": "emir report",
  "description": "The summary of a run an agent relays to a person (`markdown` is the same content as --format md).",
  "type": "object",
  "properties": {
    "schema": {
      "const": "emir.report/1"
    },
    "emir_version": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "verdict": {
      "enum": [
        "FAIL",
        "WARN",
        "CLEAN"
      ]
    },
    "disclaimer": {
      "const": "Screening, not sign-off."
    },
    "research_disclaimer": {
      "const": "EMIR is a research project, provided as is, with no warranty or guarantee of accuracy. It is your responsibility to test and verify its results for your process, tools and design before relying on them."
    },
    "simulator_verification": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "enum": [
                "verified",
                "partly verified",
                "not verified",
                "unknown simulator",
                "not applicable"
              ]
            },
            "reason": {
              "anyOf": [
                {
                  "enum": [
                    "no record",
                    "failed",
                    "stale",
                    "version unknown",
                    "other host",
                    "format not covered",
                    "current kinds not covered",
                    "records unreadable"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "simulator": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "version": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "format": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "detected_from": {
              "anyOf": [
                {
                  "enum": [
                    "result header",
                    "names sidecar",
                    "--sim"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "sim_args": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "sim_args_known": {
              "type": "boolean"
            },
            "version_checked": {
              "type": "boolean"
            },
            "record": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "simulator": {
                      "enum": [
                        "spectre",
                        "hspice",
                        "xyce",
                        "ngspice"
                      ]
                    },
                    "version": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "format": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "date": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "passed": {
                      "anyOf": [
                        {
                          "type": "boolean"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "emir_version": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "host": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "sim_args": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "covers": {
                      "anyOf": [
                        {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "simulator",
                    "passed"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "records_file": {
              "type": "string"
            },
            "ignored_records": {
              "type": "integer"
            },
            "records_problem": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "current_kinds": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "enum": [
                          "branch"
                        ]
                      },
                      "what": {
                        "type": "string"
                      },
                      "count": {
                        "type": "integer"
                      },
                      "examples": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "covered": {
                        "type": "boolean"
                      },
                      "verify_sim_covers": {
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "kind",
                      "count",
                      "covered"
                    ]
                  }
                },
                {
                  "type": "null"
                }
              ]
            },
            "command": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "note": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "status",
            "simulator",
            "version",
            "format",
            "record",
            "command"
          ],
          "description": "Whether the latest valid `emir verify-sim` record of this machine for the simulator, version, output format and simulator arguments that wrote the run's currents passed with this emir minor version (`verified`, EMIR-I463). `not verified` gives its `reason`: `no record` or `other host` or `stale` (a pass of another emir minor version) with EMIR-W464 and `command`, the verification to run; `failed` (the latest record failed: a later failure cancels an earlier pass) with EMIR-W414; `version unknown` (neither the result's header nor the names sidecar of `emir simulate` says the version: never matched to a record, `command` null) with EMIR-W416; `format not covered` (an output format emir verify-sim never writes, such as CSDF: no record can match, `command` null) with EMIR-W464; `records unreadable` (this user may not read the records file: no record counts and none could be kept, `command` null; EMIR-W415 and EMIR-W464). A verification covers kinds of current (`current_kinds`, one entry per kind the run read: the branch currents, `covered` by the record, `verify_sim_covers` whether a verification of this emir could): a run whose kinds are not all covered (a record made before records said what they cover) is `not verified`, `reason` `current kinds not covered`, with EMIR-W464. `sim_args` is what the result's names sidecar says the simulator was given (`sim_args_known` false: the result does not say, and it is matched as given none). `ignored_records` counts invalid records, `records_problem` says why a records file cannot be read at all (EMIR-W415)."
        },
        {
          "type": "null"
        }
      ]
    },
    "modes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "current_source": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "dc",
            "simulation",
            "netlist",
            "none"
          ]
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "description": {
          "type": "string"
        },
        "simulator": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "result": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "path",
        "description"
      ]
    },
    "temp_C": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    },
    "command": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "created": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "windows": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "nets": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "window": {
            "anyOf": [
              {
                "type": "object"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "nets",
          "window"
        ]
      },
      "description": "rcc's averaging windows, one per distinct window with the nets averaged over it: the run summary's `nets[].window` (null at an operating point). Empty on DC runs."
    },
    "nets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "net": {
            "type": "string"
          },
          "verdict": {
            "enum": [
              "FAIL",
              "WARN",
              "CLEAN"
            ]
          },
          "mode": {
            "type": "string"
          },
          "governing_metric": {
            "anyOf": [
              {
                "enum": [
                  "avg",
                  "rms",
                  "peak"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "metrics": {
            "type": "array",
            "items": {
              "enum": [
                "avg",
                "rms",
                "peak"
              ]
            }
          },
          "worst_ratio": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "ir_drop_mV": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "ir_kind": {
            "type": "string"
          },
          "power": {
            "type": "boolean"
          }
        },
        "required": [
          "net",
          "verdict",
          "mode",
          "governing_metric",
          "worst_ratio"
        ]
      }
    },
    "worst_items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "net": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "layer": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "wire",
              "via"
            ]
          },
          "metric": {
            "enum": [
              "avg",
              "rms",
              "peak"
            ]
          },
          "ratio": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "ratios": {
            "type": "object"
          },
          "severity": {
            "enum": [
              "FAIL",
              "WARN"
            ]
          },
          "w_um": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "cuts": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "cuts_from": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "fix": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "bbox_um": {
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 4,
                "maxItems": 4,
                "description": "where the item is: [llx, lly, urx, ury] in um (the DSPF's $LLX..$URY, or the layout's rectangle); null when the extraction wrote no coordinates"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "net",
          "name",
          "layer",
          "kind",
          "metric",
          "ratio",
          "severity",
          "fix"
        ]
      }
    },
    "ir_by_power_net": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "net": {
            "type": "string"
          },
          "ir_drop_mV": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "ir_kind": {
            "type": "string"
          },
          "dynamic_mV": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "dynamic": {
            "anyOf": [
              {
                "type": "object"
              },
              {
                "type": "null"
              }
            ]
          },
          "ir_resistance": {
            "anyOf": [
              {
                "type": "object"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "net",
          "ir_drop_mV"
        ]
      }
    },
    "not_checked": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "input_warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "run_warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "charts": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "the run's chart to attach beside the text when the reader sees images (dark, then light): a run's emir_chart.png (--html)"
    },
    "markdown": {
      "type": "string"
    },
    "limits_provenance": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "file": {
              "anyOf": [
                {
                  "enum": [
                    "hand-entered",
                    "imported-ict",
                    "public-pdk-data",
                    "mixed"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "entries": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "kind": {
                    "enum": [
                      "wire",
                      "via"
                    ]
                  },
                  "provenance": {
                    "anyOf": [
                      {
                        "enum": [
                          "hand-entered",
                          "imported-ict",
                          "public-pdk-data",
                          "mixed"
                        ]
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "sources": {
                    "type": "object",
                    "additionalProperties": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "unsourced": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "limits": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "width_loss_um": {
                    "anyOf": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "name",
                  "kind",
                  "provenance",
                  "sources",
                  "unsourced",
                  "limits"
                ]
              }
            },
            "temperature": {
              "type": "object",
              "properties": {
                "em_tref_C": {
                  "type": "number"
                },
                "em_tref_source": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "derating": {
                  "anyOf": [
                    {
                      "enum": [
                        "black",
                        "table"
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "black": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "model": {
                          "const": "black"
                        },
                        "ea_eV": {
                          "type": "number"
                        },
                        "n": {
                          "type": "number"
                        },
                        "below_tref": {
                          "anyOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        }
                      }
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "derating_source": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "unsourced": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "em_tref_C",
                "derating"
              ]
            },
            "suspects": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "value": {
                    "type": "number"
                  },
                  "unit": {
                    "type": "string"
                  },
                  "likely": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "confirmed": {
                    "type": "boolean"
                  },
                  "blocking": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "path",
                  "value",
                  "unit"
                ]
              }
            }
          },
          "required": [
            "file",
            "entries",
            "temperature"
          ],
          "description": "Where the limits the run applied came from: the process file's `provenance` (null: not stated), and per layer and via in use its own provenance, the source (document, table or page) of each value, the values a hand-entered file gives with no source (EMIR-W320), its EM limit keys and its width loss; the temperature the limits hold at, their derating and the temperatures with no source (`temperature.unsourced`); and `suspects`: the values outside the range their quantity normally takes, most often a unit slip (EMIR-W321; `blocking`: the input check refuses them, EMIR-E331; `confirmed`: listed under the file's `unit_confirmed`)."
        },
        {
          "type": "null"
        }
      ]
    },
    "limits": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schema",
    "emir_version",
    "source",
    "verdict",
    "disclaimer",
    "research_disclaimer",
    "nets",
    "worst_items",
    "ir_by_power_net",
    "not_checked",
    "input_warnings",
    "run_warnings",
    "markdown"
  ]
}
